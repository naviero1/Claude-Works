      "year": "1997"
    },
    {
      "framework": "The Triple-A supply chain",
      "originator": "Hau Lee (HBR)",
      "year": "2004"
    },
    {
      "framework": "Managing risk to avoid supply chain breakdown",
      "originator": "Chopra & Sodhi (MIT SMR)",
      "year": "2004"
    },
    {
      "framework": "Building the resilient supply chain",
      "originator": "Christopher & Peck",
      "year": "2004"
    },
    {
      "framework": "The Resilient Enterprise — the disruption profile",
