  "framework_attributions": [
    {
      "framework": "Economic order quantity",
      "originator": "F. W. Harris",
      "year": "1913"
    },
    {
      "framework": "Newsvendor / optimal inventory policy",
      "originator": "Arrow, Harris & Marschak",
      "year": "1951"
    },
    {
      "framework": "Toyota Production System, just-in-time",
      "originator": "Taiichi Ohno; Shigeo Shingo",
      "year": "1950s–1988"
    },
    {
      "framework": "Industrial dynamics — amplification through echelons",
      "originator": "Jay Forrester",
      "year": "1961"
    },
    {
      "framework": "The bullwhip effect, named, with four causes",
      "originator": "Lee, Padmanabhan & Whang",
      "year": "1997"
    },
    {
      "framework": "Risk pooling and the square-root law",
      "originator": "Gary Eppen",
      "year": "1979"
    },
    {
      "framework": "Postponement / delayed differentiation",
      "originator": "Lee & Billington (HP)",
      "year": "c.1993"
    },
    {
      "framework": "Theory of Constraints",
      "originator": "Eliyahu Goldratt",
      "year": "1984"
    },
    {
      "framework": "Lean thinking",
      "originator": "Womack & Jones",
      "year": "1996"
    },
    {
      "framework": "Functional vs innovative products",
